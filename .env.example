# This file is read automatically by `docker-compose` itself (it looks for a
# file named exactly ".env" in the same folder as docker-compose.yml) to fill
# in ${VARIABLES} inside docker-compose.yml.
#
# This is DIFFERENT from backend/.env, which is read by the Python app for
# SECRET_KEY, ALLOWED_ORIGINS, Razorpay, and SMTP settings — that one is still
# needed too (see backend/.env.example) and is passed into the container via
# docker-compose.yml's `env_file` directive.
#
# To use: copy this file to ".env" in this same folder and set a real value.

POSTGRES_PASSWORD=change_this_to_a_real_password
